# 数据库配置
# SQLite（开发默认）
DATABASE_URL=sqlite:///./lbs_poi.db
# PostgreSQL（生产环境）
# DATABASE_URL=postgresql://postgres:password@localhost:5432/lbs_poi

# JWT 密钥
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API 限速
RATE_LIMIT_PER_MINUTE=60

# 环境
DEBUG=true
